{
  "cases": [
    {
      "args": {
        "obj": [
          -5,
          -4,
          -3,
          -2,
          -1,
          0,
          1
        ],
        "fn": "(x) => x > 0"
      },
      "expected": [
        1
      ]
    },
    {
      "args": {
        "obj": {
          "a": 1,
          "b": "2",
          "c": 3,
          "d": "4",
          "e": 5,
          "f": 6,
          "g": {
            "a": 1
          }
        },
        "fn": "(x) => typeof x === \"string\""
      },
      "expected": {
        "b": "2",
        "d": "4"
      }
    },
    {
      "args": {
        "obj": [
          -1,
          [
            -1,
            -1,
            5,
            -1,
            10
          ],
          -1,
          [
            -1
          ],
          [
            -5
          ]
        ],
        "fn": "(x) => x > 0"
      },
      "expected": [
        [
          5,
          10
        ]
      ]
    },
    {
      "args": {
        "obj": [
          [
            [
              [
                5
              ]
            ]
          ]
        ],
        "fn": "(x) => Array.isArray(x)"
      },
      "expected": "undefined"
    }
  ]
}
