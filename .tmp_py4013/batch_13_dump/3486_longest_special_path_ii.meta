  "header": "// LeetCode 3486 - Longest Special Path II\n// https://leetcode.com/problems/longest-special-path-ii/\n\nvar longestSpecialPath = function(edges, nums) {\n    const n = nums.length;\n    const g = Array.from({ length: n }, () => []);\n    for (const e of edges) {\n        g[e[0]].push([e[1], e[2]]);"
}