  "header": "// LeetCode 3488 - Closest Equal Element Queries\n// https://leetcode.com/problems/closest-equal-element-queries/\n\nvar solveQueries = function(nums, queries) {\n    const n = nums.length;\n    const pos = new Map();\n    for (let i = 0; i < n; i++) {\n        if (!pos.has(nums[i])) pos.set(nums[i], []);"
