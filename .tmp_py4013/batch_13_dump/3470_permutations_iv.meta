  "header": "// LeetCode 3470 - Permutations IV\n// https://leetcode.com/problems/permutations-iv/\n\nvar permute = function(n, k) {\n    const fact = new Array(n + 1);\n    fact[0] = 1n;\n    for (let i = 1; i <= n; i++) {\n        fact[i] = fact[i - 1] * BigInt(i);"
}