  "header": "// LeetCode 3453 - Separate Squares I\n// https://leetcode.com/problems/separate-squares-i/\n\nvar separateSquares = function(squares) {\n    let total = 0;\n    for (const sq of squares) {\n        const l = sq[2];\n        total += l * l;"
