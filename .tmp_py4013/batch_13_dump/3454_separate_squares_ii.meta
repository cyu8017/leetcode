  "header": "// LeetCode 3454 - Separate Squares II\n// https://leetcode.com/problems/separate-squares-ii/\n\nvar separateSquares = function(squares) {\n    let total = 0;\n    for (const sq of squares) {\n        const l = sq[2];\n        total += l * l;"
