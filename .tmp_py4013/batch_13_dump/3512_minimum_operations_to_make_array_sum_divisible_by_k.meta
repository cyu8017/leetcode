  "title": "Minimum Operations To Make Array Sum Divisible By K",
  "method": "minOperations",
  "class": "Solution",
  "kind": null,
  "js_size": 281,
  "js_lines": 8,
  "header": "// LeetCode 3512 - Minimum Operations to Make Array Sum Divisible by K\n// https://leetcode.com/problems/minimum-operations-to-make-array-sum-divisible-by-k/\n\nvar minOperations = function(nums, k) {\n    let ans = 0;\n    for (const x of nums) ans = (ans + x) % k;\n    return ans;\n};"
}