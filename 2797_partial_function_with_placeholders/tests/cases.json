{
  "cases": [
    {
      "args": {
        "fn": "(...args) => args",
        "args": [
          2,
          4,
          6
        ],
        "restArgs": [
          8,
          10
        ]
      },
      "expected": [
        2,
        4,
        6,
        8,
        10
      ]
    },
    {
      "args": {
        "fn": "(...args) => args",
        "args": [
          1,
          2,
          "_",
          4,
          "_",
          6
        ],
        "restArgs": [
          3,
          5
        ]
      },
      "expected": [
        1,
        2,
        3,
        4,
        5,
        6
      ]
    },
    {
      "args": {
        "fn": "(a, b, c) => b + a - c",
        "args": [
          "_",
          5
        ],
        "restArgs": [
          5,
          20
        ]
      },
      "expected": -10
    }
  ]
}
